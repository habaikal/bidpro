<% 
  status_map = { 
    'Imminent' => { text: '마감임박', class: 'bg-red-500/20 text-red-200 border-red-500/30' },
    'New' => { text: '신규공고', class: 'bg-green-500/20 text-green-200 border-green-500/30' },
    'Open' => { text: '진행중', class: 'bg-blue-500/20 text-blue-200 border-blue-500/30' },
    'Closed' => { text: '마감됨', class: 'bg-gray-500/20 text-gray-300 border-gray-500/30' }
  }
  status_info = status_map[bid.status] || status_map['Open']
%>
<div class="glass-panel p-6 rounded-[1.5rem] border border-white/10 hover:border-indigo-400/50 transition-all duration-300 group hover:shadow-2xl hover:shadow-indigo-500/10 relative overflow-hidden" id="bid_card_<%= bid.id %>">
  
  <div class="flex justify-between items-start mb-5 relative z-10">
    <div class="w-full">
      <div class="flex justify-between items-start w-full mb-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border <%= status_info[:class] %> backdrop-blur-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-current mr-2 animate-pulse"></span>
          <%= status_info[:text] %>
        </span>
        <span class="text-xs text-indigo-300 font-mono tracking-wider opacity-60">#<%= bid.id.to_s.rjust(5, '0') %></span>
      </div>
      
      <h3 class="text-xl font-bold text-white mb-2 leading-snug group-hover:text-indigo-300 transition-colors line-clamp-2"><%= bid.title %></h3>
      <p class="text-indigo-200/70 text-sm mb-5 line-clamp-2 leading-relaxed font-light"><%= bid.description %></p>
      
      <div class="flex items-center space-x-4 text-sm text-indigo-100/60 border-b border-white/5 pb-5 mb-5">
        <span class="flex items-center"><i class="ph ph-buildings mr-2 text-indigo-400"></i> <%= bid.agency %></span>
        <span class="flex items-center"><i class="ph ph-calendar-blank mr-2 text-indigo-400"></i> <%= bid.deadline.strftime("%Y.%m.%d") %> 마감</span>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3 mb-6 relative z-10">
    <div class="bg-indigo-950/30 rounded-2xl p-4 border border-indigo-500/10 hover:bg-indigo-900/40 transition-colors">
      <p class="text-xs text-indigo-300/80 mb-1 font-medium">기초 금액</p>
      <p class="text-white font-bold text-lg"><%= number_to_currency(bid.base_price, unit: "", precision: 0) %><span class="text-sm font-normal text-indigo-300 ml-1">원</span></p>
    </div>
    <div class="bg-gradient-to-br from-indigo-500/10 to-purple-500/10 rounded-2xl p-4 border border-indigo-500/40 relative overflow-hidden group-hover:border-indigo-400/60 transition-colors">
      <!-- Premium Shimmer effect -->
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -skew-x-12 translate-x-[-200%] animate-shimmer"></div>
      
      <p class="text-xs text-indigo-200 mb-1 flex items-center font-bold tracking-wide"><i class="ph ph-sparkle mr-1.5 text-yellow-400"></i> AI 예측가</p>
      <div class="flex flex-col relative z-10">
        <p class="text-white font-extrabold text-lg tracking-tight drop-shadow-sm"><%= number_to_currency(bid.predicted_price, unit: "", precision: 0) %><span class="text-sm font-normal text-indigo-300 ml-1">원</span></p>
        <div class="w-full bg-gray-700/50 h-1.5 rounded-full mt-2.5 overflow-hidden">
          <div class="bg-gradient-to-r from-green-400 to-emerald-400 h-full rounded-full shadow-[0_0_10px_rgba(52,211,153,0.5)]" style="width: <%= bid.confidence_score %>%"></div>
        </div>
        <p class="text-[10px] text-emerald-300 mt-1.5 text-right font-bold uppercase tracking-wider">신뢰도 <%= bid.confidence_score %>%</p>
      </div>
    </div>
  </div>

  <!-- NanoBanana Image Simulation -->
  <div class="flex items-center p-3 rounded-xl bg-white/5 border border-white/5 mb-6 hover:bg-white/10 transition-colors cursor-pointer">
    <div class="h-10 w-10 rounded-lg bg-indigo-500/20 flex items-center justify-center mr-3 border border-indigo-500/20">
      <i class="ph ph-image text-indigo-300 text-xl"></i>
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-sm font-bold text-gray-200 truncate">NanoBanana 시각 자료 생성</p>
      <p class="text-xs text-gray-400 truncate">프롬프트: <%= bid.category %> 프로젝트 제안서용 시각화...</p>
    </div>
    <span class="px-2.5 py-1 text-[10px] font-bold rounded-lg bg-indigo-500/20 text-indigo-300 border border-indigo-500/20">준비완료</span>
  </div>

  <div class="pt-2 flex justify-between items-center relative z-10" id="bid_action_<%= bid.id %>">
    <%= form_with url: auto_bid_bid_path(bid), method: :post, class: "w-full", data: { turbo_frame: "bid_modal_#{bid.id}" } do |f| %>
       <div class="flex space-x-3 w-full">
         <div class="relative w-1/2">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-indigo-300 text-sm font-bold">₩</span>
            <%= f.number_field :amount, value: bid.predicted_price, class: "w-full bg-indigo-950/50 border border-indigo-500/30 rounded-xl pl-8 pr-4 py-3 text-white placeholder-indigo-400/50 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all", placeholder: "입찰 금액" %>
         </div>
         <button type="submit" class="w-1/2 bg-gradient-to-r from-indigo-600 via-purple-600 to-indigo-600 bg-[length:200%_auto] animate-shimmer hover:bg-[position:right_center] text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-indigo-500/30 transition-all transform hover:scale-[1.02] flex items-center justify-center group-hover:shadow-indigo-500/50">
           <i class="ph ph-lightning mr-2 text-yellow-300"></i> 원클릭 AI 입찰
         </button>
       </div>
    <% end %>
  </div>
  
  <!-- Turbo Frame for Modal/Result -->
  <%= turbo_frame_tag "bid_modal_#{bid.id}" %>
</div>
