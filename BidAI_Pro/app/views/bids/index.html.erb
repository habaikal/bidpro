<div class="flex h-screen overflow-hidden bg-premium-dark" data-controller="sidebar">
  <!-- Sidebar Navigation -->
  <aside class="w-20 md:w-64 glass-premium border-r border-white/5 flex flex-col justify-between z-20 hidden md:flex transition-all duration-300">
    <div>
      <div class="p-6 md:p-8 flex items-center space-x-3 mb-2">
        <div class="p-2 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl shadow-lg shadow-indigo-500/30">
          <i class="ph ph-brain text-2xl text-white"></i>
        </div>
        <span class="text-xl font-bold text-white tracking-wide hidden md:block">BidAI<span class="text-indigo-400">Pro</span></span>
      </div>
      
      <!-- Trust Badge -->
      <div class="px-6 mb-6 hidden md:block">
        <div class="py-1 px-3 bg-green-500/10 border border-green-500/20 rounded-full flex items-center justify-center space-x-2">
            <i class="ph ph-shield-check text-green-400 text-xs"></i>
            <span class="text-[10px] text-green-200 font-bold">GovTech 인증 완료</span>
        </div>
      </div>

      <nav class="space-y-2 px-4">
        <a href="#" class="flex items-center p-3 rounded-xl bg-indigo-500/20 text-white border border-indigo-500/30 shadow-lg shadow-indigo-500/10 group relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-r from-indigo-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <i class="ph ph-squares-four text-xl mr-0 md:mr-3 text-indigo-300"></i>
          <span class="font-medium hidden md:block">대시보드</span>
        </a>
        <a href="#" class="flex items-center p-3 rounded-xl text-indigo-300 hover:bg-white/5 hover:text-white transition-all group">
          <i class="ph ph-chart-line-up text-xl mr-0 md:mr-3 group-hover:text-indigo-400"></i>
          <span class="font-medium hidden md:block">AI 예측 분석</span>
        </a>
        <a href="#" class="flex items-center p-3 rounded-xl text-indigo-300 hover:bg-white/5 hover:text-white transition-all group">
          <i class="ph ph-trophy text-xl mr-0 md:mr-3 group-hover:text-yellow-400"></i>
          <span class="font-medium hidden md:block">나의 낙찰 성과</span>
        </a>
        <a href="#" class="flex items-center p-3 rounded-xl text-indigo-300 hover:bg-white/5 hover:text-white transition-all group">
          <i class="ph ph-gear text-xl mr-0 md:mr-3 group-hover:text-indigo-400"></i>
          <span class="font-medium hidden md:block">설정</span>
        </a>
      </nav>
    </div>

    <div class="p-4 space-y-4">
       <!-- Risk Mitigation / Up-sell -->
      <div class="p-4 rounded-2xl bg-gradient-to-br from-indigo-900/80 to-purple-900/80 border border-indigo-500/20 shadow-lg text-center relative overflow-hidden group cursor-pointer hidden md:block">
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -skew-x-12 translate-x-[-200%] group-hover:animate-shimmer"></div>
        <div class="mb-2 inline-flex p-1.5 rounded-full bg-indigo-500/20 border border-indigo-500/30">
           <i class="ph ph-crown text-yellow-400 text-lg"></i>
        </div>
        <h4 class="text-white font-bold text-sm mb-1">PRO 플랜 무료 체험</h4>
        <p class="text-[10px] text-indigo-200 mb-2">잔여 14일 • 언제든 해지 가능</p>
        <div class="text-[9px] text-indigo-300/70 border-t border-white/5 pt-2 mt-2">
            <i class="ph ph-check-circle mr-1"></i>낙찰 미성공 시 100% 환불
        </div>
      </div>
    </div>
  </aside>

  <!-- Mobile Header (Visible only on small screens) -->
  <div class="md:hidden fixed top-0 w-full z-40 glass-premium px-4 py-3 flex justify-between items-center border-b border-white/10 backdrop-blur-xl">
     <div class="flex items-center space-x-2">
        <div class="p-1.5 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-lg shadow-[0_0_10px_rgba(99,102,241,0.5)]">
          <i class="ph ph-brain text-lg text-white"></i>
        </div>
        <span class="font-bold text-white tracking-wide">BidAI Pro</span>
     </div>
     <div class="flex items-center space-x-3">
        <span class="px-2 py-0.5 rounded-full bg-green-500/20 border border-green-500/20 text-[10px] text-green-300 font-bold">PRO</span>
        <button class="text-white p-1">
          <i class="ph ph-list text-2xl"></i>
        </button>
     </div>
  </div>

  <!-- Main Content Area -->
  <main class="flex-1 overflow-y-auto h-full pt-16 md:pt-0 scroll-smooth">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
      
      <!-- Top Bar & ROI Value Proposition -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 md:mb-10 space-y-4 md:space-y-0">
        <div>
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-400/20 mb-3 animate-fade-in-up">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 mr-2 animate-pulse"></span>
              <span class="text-xs text-indigo-200 font-medium">홍길동님의 성공적인 하루를 응원합니다!</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight mb-2">
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-indigo-100 to-indigo-300">입찰 관리 대시보드</span>
          </h2>
          <p class="text-indigo-200/70 text-sm md:text-base">AI가 분석한 <span class="text-indigo-300 font-bold border-b border-indigo-500/30">최적의 승리 전략</span>을 확인하세요.</p>
        </div>
        
        <div class="flex items-center space-x-4 w-full md:w-auto">
             <!-- ROI Card -->
             <div class="flex-1 md:flex-none bg-gradient-to-br from-indigo-600 to-purple-700 p-4 rounded-2xl shadow-lg shadow-indigo-500/20 border-t border-white/20 relative overflow-hidden">
                <div class="absolute -right-4 -top-4 w-20 h-20 bg-white/10 rounded-full blur-xl"></div>
                <p class="text-xs text-indigo-200 mb-1 font-medium">이번 달 예상 예산 절감액</p>
                <div class="flex items-end space-x-2">
                    <span class="text-2xl font-extrabold text-white">₩54,000,000</span>
                    <span class="text-xs text-green-300 font-bold mb-1 flex items-center bg-green-500/20 px-1.5 py-0.5 rounded-lg"><i class="ph ph-trend-up mr-0.5"></i> 12%</span>
                </div>
             </div>
        </div>
      </div>

      <!-- Stats Grid (Visual Upgrade) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-10">
        <%= render partial: "stat_card", locals: { title: "분석된 공고", value: "#{number_with_delimiter(@dashboard_stats[:total_bids])}", unit: "건", icon: "scan", color: "indigo", progress: 85 } %>
        <%= render partial: "stat_card", locals: { title: "나의 낙찰", value: "#{number_with_delimiter(@dashboard_stats[:won_bids])}", unit: "건", icon: "trophy", color: "amber", progress: 65 } %>
        <%= render partial: "stat_card", locals: { title: "예상 성공률", value: "#{@dashboard_stats[:success_rate]}", unit: "%", icon: "chart-pie-slice", color: "emerald", progress: @dashboard_stats[:success_rate] } %>
        <%= render partial: "stat_card", locals: { title: "총 절감률", value: "#{@dashboard_stats[:avg_savings]}", unit: "%", icon: "wallet", color: "cyan", progress: @dashboard_stats[:avg_savings] } %>
      </div>

      <!-- Content Area -->
      <div class="flex flex-col xl:flex-row gap-8">
        <!-- Main Feed -->
        <div class="flex-1 space-y-6">
           <!-- Filters -->
           <div class="flex justify-between items-center bg-white/5 p-2 rounded-2xl border border-white/5 backdrop-blur-sm overflow-x-auto">
              <div class="flex space-x-1">
                <button class="px-4 py-2 rounded-xl bg-indigo-500 text-white font-bold text-sm shadow-lg shadow-indigo-500/30 whitespace-nowrap">AI 추천 🔥</button>
                <button class="px-4 py-2 rounded-xl text-indigo-300 hover:bg-white/5 hover:text-white transition text-sm font-medium whitespace-nowrap">관심 공고</button>
                <button class="px-4 py-2 rounded-xl text-indigo-300 hover:bg-white/5 hover:text-white transition text-sm font-medium whitespace-nowrap">마감 임박</button>
              </div>
              <button class="px-3 py-2 text-indigo-300 hover:text-white hidden md:block">
                <i class="ph ph-sliders-horizontal text-lg"></i>
              </button>
           </div>
           
           <div class="grid grid-cols-1 gap-5">
              <% @bids.each do |bid| %>
                <%= render partial: "bid_card", locals: { bid: bid } %>
              <% end %>
           </div>
        </div>

        <!-- Right Side Widgets (Social Proof & Community) -->
        <div class="xl:w-80 space-y-6 hidden xl:block">
           
           <!-- Activity Feed (Social Proof) -->
           <div class="glass-premium p-6 rounded-[2rem] border-t-2 border-t-indigo-500">
              <div class="flex justify-between items-center mb-5">
                 <h3 class="text-lg font-bold text-white flex items-center">
                    <i class="ph ph-broadcast text-green-400 mr-2 animate-pulse"></i> 실시간 낙찰 현황
                 </h3>
                 <span class="text-[10px] text-indigo-300 bg-white/5 px-2 py-1 rounded-lg">LIVE</span>
              </div>
              
              <div class="space-y-4 relative">
                <div class="absolute left-2.5 top-2 bottom-2 w-0.5 bg-gradient-to-b from-indigo-500/20 via-indigo-500/50 to-transparent"></div>
                
                <div class="flex items-start pl-7 relative group cursor-pointer">
                   <div class="absolute left-0 top-1 w-5 h-5 rounded-full bg-indigo-950 border-2 border-amber-400 z-10 flex items-center justify-center">
                      <i class="ph ph-crown-simple text-[10px] text-amber-400"></i>
                   </div>
                   <div class="bg-white/5 p-3 rounded-xl border border-white/5 hover:bg-white/10 transition w-full">
                     <div class="flex justify-between items-start mb-1">
                        <span class="text-xs font-bold text-white">주식회사 **테크</span>
                        <span class="text-[10px] text-indigo-300">방금 전</span>
                     </div>
                     <p class="text-xs text-indigo-200 leading-snug"><span class="text-amber-300 font-bold">1.2억원</span> 규모 보안 사업 낙찰 성공!</p>
                   </div>
                </div>

                <div class="flex items-start pl-7 relative group cursor-pointer">
                   <div class="absolute left-0 top-1 w-5 h-5 rounded-full bg-indigo-950 border-2 border-indigo-500 z-10"></div>
                   <div>
                     <p class="text-[10px] text-indigo-400 mb-0.5">2분 전</p>
                     <p class="text-xs text-indigo-200">**건설이 <span class="text-white font-bold">도로 정비 사업</span>에 AI 자동 입찰을 완료했습니다.</p>
                   </div>
                </div>

                <div class="flex items-start pl-7 relative group cursor-pointer">
                   <div class="absolute left-0 top-1 w-5 h-5 rounded-full bg-indigo-950 border-2 border-indigo-500 z-10"></div>
                   <div>
                     <p class="text-[10px] text-indigo-400 mb-0.5">5분 전</p>
                     <p class="text-xs text-indigo-200">**시스템이 <span class="text-white font-bold">서버 구축</span> 공고를 관심 목록에 추가했습니다.</p>
                   </div>
                </div>
              </div>
           </div>
           
           <!-- Support Widget -->
           <div class="glass-premium p-6 rounded-[2rem] text-center relative overflow-hidden group">
               <div class="absolute inset-0 bg-indigo-600/10 group-hover:bg-indigo-600/20 transition-colors"></div>
               <div class="relative z-10">
                   <div class="w-12 h-12 mx-auto bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full flex items-center justify-center mb-3 shadow-lg shadow-indigo-500/30">
                       <i class="ph ph-chats-circle text-2xl text-white"></i>
                   </div>
                   <h4 class="text-white font-bold mb-1">전문가 1:1 컨설팅</h4>
                   <p class="text-xs text-indigo-200 mb-4 px-4">입찰 전략이 고민이신가요? AI 전문가가 도와드립니다.</p>
                   <button class="w-full py-2.5 rounded-xl bg-white text-indigo-900 font-bold text-sm hover:bg-indigo-50 transition shadow-lg">상담 예약하기</button>
               </div>
           </div>

        </div>
      </div>
    </div>
  </main>
</div>
