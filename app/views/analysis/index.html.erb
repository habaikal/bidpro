<div class="flex h-screen overflow-hidden bg-premium-dark">
  <%= render "shared/sidebar" %>

  <main class="flex-1 overflow-y-auto h-full bg-[#0B0E14]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
      <h2 class="text-3xl font-bold text-white mb-8">분석 레포트</h2>

      <!-- Charts Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
         <div class="card-premium p-6">
            <h3 class="text-white font-bold mb-4">월별 낙찰 성과</h3>
            <!-- Placeholder for Chart -->
            <div class="h-64 bg-[#0B0E14] rounded-xl flex items-end justify-between p-4 border border-[#2A303C]">
               <% @monthly_performance.each do |val| %>
                  <div class="w-8 bg-yellow-500 rounded-t-lg hover:bg-yellow-400 transition-all" style="height: <%= val %>%"></div>
               <% end %>
            </div>
         </div>
         
         <div class="card-premium p-6">
            <h3 class="text-white font-bold mb-4">카테고리별 비중</h3>
            <div class="flex items-center justify-center h-64">
               <div class="w-48 h-48 rounded-full border-8 border-yellow-500 border-r-blue-500 border-b-green-500"></div>
            </div>
            <div class="flex justify-center space-x-4 mt-4 text-sm">
               <span class="flex items-center text-gray-400"><span class="w-3 h-3 rounded-full bg-yellow-500 mr-2"></span> 서비스</span>
               <span class="flex items-center text-gray-400"><span class="w-3 h-3 rounded-full bg-blue-500 mr-2"></span> IT</span>
               <span class="flex items-center text-gray-400"><span class="w-3 h-3 rounded-full bg-green-500 mr-2"></span> 건설</span>
            </div>
         </div>
      </div>
    </div>
  </main>
</div>
