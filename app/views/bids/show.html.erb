<div class="flex h-screen overflow-hidden bg-premium-dark">
  <%= render "shared/sidebar" %>

  <main class="flex-1 overflow-y-auto h-full bg-[#0B0E14]">
    <!-- Mobile Header -->
    <div class="md:hidden sticky top-0 z-40 bg-[#0B0E14]/90 px-4 py-3 flex justify-between items-center border-b border-[#2A303C] backdrop-blur-xl">
       <div class="flex items-center space-x-2">
          <%= link_to root_path do %>
            <i class="ph ph-caret-left text-white text-xl"></i>
          <% end %>
          <span class="font-bold text-white tracking-wide">공고 상세</span>
       </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
      
      <!-- Breadcrumb / Back -->
      <div class="mb-6 flex items-center space-x-2 text-sm text-gray-500">
        <%= link_to "대시보드", root_path, class: "hover:text-yellow-400" %>
        <i class="ph ph-caret-right text-xs"></i>
        <span class="text-gray-300">공고 상세</span>
        <i class="ph ph-caret-right text-xs"></i>
        <span class="text-yellow-400 font-bold">#<%= @bid.id %></span>
      </div>

      <!-- Header Section -->
      <div class="flex flex-col md:flex-row justify-between items-start mb-8 gap-4">
        <div>
           <div class="flex items-center space-x-3 mb-3">
             <span class="badge-d-day bg-red-900/50 text-red-400 border border-red-500/30">D-<%= (@bid.deadline.to_date - Date.today).to_i %></span>
             <span class="text-sm text-gray-400"><%= @bid.category %></span>
           </div>
           <h1 class="text-2xl md:text-3xl font-bold text-white mb-2 leading-tight"><%= @bid.title %></h1>
           <div class="flex items-center text-gray-400 text-sm">
             <i class="ph ph-buildings mr-2"></i> <%= @bid.agency %>
             <span class="mx-3 text-gray-700">|</span>
             <i class="ph ph-calendar-blank mr-2"></i> <%= @bid.deadline.strftime("%Y년 %m월 %d일 %H:%M") %> 마감
           </div>
        </div>
        
        <div class="flex space-x-3 w-full md:w-auto">
           <button class="p-3 rounded-xl bg-[#151923] border border-[#2A303C] text-gray-400 hover:text-white hover:border-white/20">
              <i class="ph ph-share-network text-xl"></i>
           </button>
           <button class="p-3 rounded-xl bg-[#151923] border border-[#2A303C] text-gray-400 hover:text-yellow-400 hover:border-yellow-500/30">
              <i class="ph ph-bookmark-simple text-xl"></i>
           </button>
        </div>
      </div>

      <!-- Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left Column (Details) -->
        <div class="lg:col-span-2 space-y-8">
           <!-- Price Info -->
           <div class="card-premium p-6">
              <h3 class="text-lg font-bold text-white mb-6 flex items-center">
                <i class="ph ph-money w-6 h-6 mr-2 text-gray-500"></i> 투찰 예가 분석
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                 <div class="bg-[#0B0E14] p-4 rounded-xl border border-[#2A303C]">
                    <p class="text-sm text-gray-500 mb-1">기초 예비 가격</p>
                    <p class="text-xl font-bold text-white">₩ <%= number_to_currency(@bid.base_price, unit: "", precision: 0) %></p>
                 </div>
                 <div class="bg-yellow-500/10 p-4 rounded-xl border border-yellow-500/30 relative overflow-hidden">
                    <div class="absolute inset-0 bg-yellow-500/5 animate-pulse-slow"></div>
                    <p class="text-sm text-yellow-500 mb-1 font-bold flex items-center"><i class="ph ph-brain mr-1"></i> AI 예측 최적가</p>
                    <p class="text-xl font-bold text-yellow-400">₩ <%= number_to_currency(@bid.predicted_price, unit: "", precision: 0) %></p>
                    <p class="text-[10px] text-yellow-600 mt-1">낙찰 확률 87% 구간</p>
                 </div>
              </div>
           </div>

           <!-- Content Body -->
           <div class="card-premium p-8">
              <h3 class="text-lg font-bold text-white mb-4">공고 개요</h3>
              <div class="prose prose-invert max-w-none text-gray-300 text-sm leading-relaxed">
                 <p><%= @bid.description.presence || "상세 설명이 제공되지 않은 공고입니다. 공고 원문을 참조하시기 바랍니다." %></p>
                 
                 <h4 class="text-white font-bold mt-6 mb-2">주요 과업 내용</h4>
                 <ul class="list-disc pl-5 space-y-1 text-gray-400">
                    <li>시스템 아키텍처 설계 및 구축</li>
                    <li>데이터 마이그레이션 및 정합성 검증</li>
                    <li>보안성 검토 및 취약점 조치</li>
                 </ul>
              </div>
           </div>
        </div>

        <!-- Right Column (Analysis & Action) -->
        <div class="space-y-6">
           
           <!-- AI Score Card -->
           <div class="card-premium p-6 border-yellow-500/30 shadow-lg shadow-yellow-500/5">
              <h3 class="text-white font-bold mb-4 flex items-center">
                 <i class="ph ph-chart-polar text-yellow-500 mr-2"></i> AI 적합성 분석
              </h3>
              
              <div class="flex justify-center my-6 relative">
                 <!-- Circular Progress Placeholder -->
                 <div class="w-32 h-32 rounded-full border-8 border-[#151923] flex items-center justify-center relative z-10">
                    <div class="absolute inset-0 rounded-full border-8 border-yellow-500 border-t-transparent animate-spin" style="animation-duration: 3s;"></div>
                    <div class="text-center">
                       <span class="block text-2xl font-bold text-white"><%= @bid.confidence_score %></span>
                       <span class="block text-[10px] text-gray-500">SCORE</span>
                    </div>
                 </div>
              </div>

              <div class="space-y-3">
                 <div class="flex justify-between items-center text-sm">
                    <span class="text-gray-400">기술 적합도</span>
                    <span class="text-white font-bold">92/100</span>
                 </div>
                 <div class="w-full bg-[#0B0E14] h-1.5 rounded-full overflow-hidden">
                    <div class="bg-blue-500 h-full w-[92%]"></div>
                 </div>
                 
                 <div class="flex justify-between items-center text-sm mt-3">
                    <span class="text-gray-400">실적 매칭</span>
                    <span class="text-white font-bold">85/100</span>
                 </div>
                 <div class="w-full bg-[#0B0E14] h-1.5 rounded-full overflow-hidden">
                    <div class="bg-green-500 h-full w-[85%]"></div>
                 </div>
              </div>
           </div>

           <!-- Action Button -->
           <div class="sticky top-24">
              <button class="w-full py-4 rounded-xl bg-yellow-500 text-black font-bold text-lg hover:bg-yellow-400 transition-all shadow-xl shadow-yellow-500/20 mb-3 flex items-center justify-center">
                 <i class="ph ph-lightning mr-2 text-xl"></i> 입찰 시뮬레이션
              </button>
              <button class="w-full py-4 rounded-xl bg-[#151923] border border-[#2A303C] text-gray-300 font-bold hover:bg-[#1A1E29] hover:text-white transition-all">
                 제안서 초안 생성
              </button>
           </div>

        </div>
      </div>

    </div>
  </main>
</div>
