<aside class="w-20 md:w-64 bg-[#0B0E14] border-r border-[#2A303C] flex flex-col justify-between z-20 hidden md:flex transition-all duration-300">
  <div>
    <div class="p-6 md:p-8 flex items-center space-x-3 mb-2">
      <div class="p-2 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-xl shadow-lg shadow-yellow-500/20">
        <i class="ph ph-brain text-2xl text-black"></i>
      </div>
      <span class="text-xl font-bold text-white tracking-wide hidden md:block">BidAI<span class="text-yellow-400">Pro</span></span>
    </div>
    
    <!-- Trust Badge -->
    <div class="px-6 mb-6 hidden md:block">
      <div class="py-1 px-3 bg-[#151923] border border-[#2A303C] rounded-full flex items-center justify-center space-x-2">
          <i class="ph ph-shield-check text-gray-400 text-xs"></i>
          <span class="text-[10px] text-gray-400 font-bold">GovTech 인증 완료</span>
      </div>
    </div>

    <nav class="space-y-2 px-4">
      <%= link_to root_path, class: "flex items-center p-3 rounded-xl #{current_page?(root_path) ? 'bg-yellow-500 text-black shadow-lg shadow-yellow-500/20 font-bold' : 'text-gray-400 hover:bg-[#151923] hover:text-white'} transition-all group relative overflow-hidden" do %>
        <i class="ph ph-squares-four text-xl mr-0 md:mr-3"></i>
        <span class="hidden md:block">대시보드</span>
      <% end %>
      
      <%= link_to analysis_index_path, class: "flex items-center p-3 rounded-xl #{current_page?(analysis_index_path) ? 'bg-yellow-500 text-black shadow-lg shadow-yellow-500/20 font-bold' : 'text-gray-400 hover:bg-[#151923] hover:text-white'} transition-all group" do %>
        <i class="ph ph-chart-line-up text-xl mr-0 md:mr-3 group-hover:text-yellow-400"></i>
        <span class="font-medium hidden md:block">분석 레포트</span>
      <% end %>

      <%= link_to interested_bids_index_path, class: "flex items-center p-3 rounded-xl #{current_page?(interested_bids_index_path) ? 'bg-yellow-500 text-black shadow-lg shadow-yellow-500/20 font-bold' : 'text-gray-400 hover:bg-[#151923] hover:text-white'} transition-all group" do %>
        <i class="ph ph-folder-star text-xl mr-0 md:mr-3 group-hover:text-yellow-400"></i>
        <span class="font-medium hidden md:block">관심 공고</span>
      <% end %>

      <%= link_to settings_index_path, class: "flex items-center p-3 rounded-xl #{current_page?(settings_index_path) ? 'bg-yellow-500 text-black shadow-lg shadow-yellow-500/20 font-bold' : 'text-gray-400 hover:bg-[#151923] hover:text-white'} transition-all group" do %>
        <i class="ph ph-gear text-xl mr-0 md:mr-3 group-hover:text-yellow-400"></i>
        <span class="font-medium hidden md:block">설정</span>
      <% end %>
    </nav>
  </div>

  <!-- Bottom Action -->
  <div class="p-4">
     <button class="w-full py-3 rounded-xl bg-[#151923] border border-[#2A303C] text-gray-400 hover:text-white hover:border-yellow-500/30 transition-all flex items-center justify-center">
        <i class="ph ph-sign-out text-lg mr-2"></i>
        <span class="hidden md:inline text-sm font-bold">로그아웃</span>
     </button>
  </div>
</aside>
